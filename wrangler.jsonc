{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lariojapark",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "main": "src/worker.ts",
  "upload_source_maps": false
}
