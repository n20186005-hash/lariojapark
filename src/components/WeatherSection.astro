<section id="tiempo" class="section" aria-labelledby="tiempo-titulo">
  <div class="shell">
    <p class="eyebrow">Clima en La Rioja</p>
    <h2 id="tiempo-titulo" class="heading">Tiempo ahora y pronóstico de varios días</h2>
    <p class="subheading" style="max-width:56rem">
      Pronóstico de modelo para el entorno del parque, no una confirmación de apertura ni una alerta oficial. Verificá las indicaciones locales antes de salir.
    </p>

    <div class="wx-card">
      <div id="weather-now" set:html={'<p class="wx-fallback">Cargando pronóstico…</p>'}></div>
      <div id="weather-advice" ></div>
      <div id="weather-days" ></div>
    </div>
    <p id="weather-status" class="wx-status" role="status" aria-live="polite">
      Sin datos de referencia guardados. El pronóstico se solicita al abrir la página.
    </p>
    <p class="wx-status"><a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo</a> · Datos de modelo para La Rioja. <noscript>Activá JavaScript para solicitar el pronóstico actual.</noscript></p>
  </div>
</section>

<script>
  import { buildWeatherUrl, buildNow, buildDays, buildAdvice, validateWeather, weatherTime } from '../lib/weather';

  (async () => {
    const nowEl = document.getElementById('weather-now');
    const advEl = document.getElementById('weather-advice');
    const daysEl = document.getElementById('weather-days');
    const statusEl = document.getElementById('weather-status');
    if (!nowEl || !daysEl) return;

    try {
      const res = await fetch(buildWeatherUrl(), {signal:AbortSignal.timeout(8000),cache:"no-store"});
      if (!res.ok) throw new Error('http');
      const w = await res.json();
      validateWeather(w);
      nowEl.innerHTML = buildNow(w);
      if (advEl) advEl.innerHTML = buildAdvice(w);
      daysEl.innerHTML = buildDays(w);
      if (statusEl) statusEl.textContent = 'Modelo Open-Meteo · ' + weatherTime(w) + ' (hora de La Rioja). No establece cierres del parque.';
    } catch (e) {
      nowEl.textContent = 'No pudimos obtener un pronóstico verificado. Consultá el clima y los avisos locales antes de salir.';
      if (advEl) advEl.replaceChildren();
      daysEl.replaceChildren();
      if (statusEl) statusEl.textContent = 'Pronóstico temporalmente no disponible. Volvé a cargar la página para reintentar.';
    }
  })();
</script>
